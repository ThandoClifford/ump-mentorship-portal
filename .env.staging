APP_NAME=UMP Mentorship Portal
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://staging.yourdomain.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ump_mentorship_staging
DB_USERNAME=staging_user
DB_PASSWORD=change_me

CACHE_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=staging_smtp_user
MAIL_PASSWORD=change_me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@staging.yourdomain.com
MAIL_FROM_NAME="UMP Mentorship Portal (Staging)"

REMINDER_WINDOW_HOURS=24
BACKUP_DISKS=local
BACKUP_MAIL_TO=ops-staging@yourdomain.com
BACKUP_ARCHIVE_PASSWORD=change_me
BACKUP_SLACK_WEBHOOK_URL=
BACKUP_DISCORD_WEBHOOK_URL=
